{
  "id": "b_bnd03_signed_range_end",
  "arm": "B",
  "class": "bounds",
  "ub_by_construction": true,
  "ub_pattern": "signed_overflow_in_bounds_check",
  "control_role": "positive",
  "description": "range check end = off + len (signed) then end < off || end > cap",
  "functions": [
    "range_end"
  ],
  "guard_ids": [
    39,
    40
  ],
  "loops": false,
  "alive2_unroll": 0,
  "inputs": [
    {
      "args": [
        "10",
        "5",
        "100"
      ],
      "guard": "pass",
      "expect_reports": [],
      "expect_guard_output": false
    },
    {
      "args": [
        "10",
        "-1",
        "100"
      ],
      "guard": "trip",
      "expect_reports": [],
      "expect_guard_output": true,
      "note": "len < 0, guard 39, no UB"
    },
    {
      "args": [
        "90",
        "20",
        "100"
      ],
      "guard": "trip",
      "expect_reports": [],
      "expect_guard_output": true,
      "note": "end > cap, guard 40, no UB"
    },
    {
      "args": [
        "2147483647",
        "1",
        "100"
      ],
      "guard": "trip",
      "expect_reports": [
        "ubsan:signed-integer-overflow"
      ],
      "expect_guard_output": true,
      "note": "off + len wraps; -O0 wraps so end < off trips guard 40"
    }
  ]
}