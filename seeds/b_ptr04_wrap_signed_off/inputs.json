{
  "id": "b_ptr04_wrap_signed_off",
  "arm": "B",
  "class": "bounds",
  "ub_by_construction": true,
  "ub_pattern": "pointer_wrap_check",
  "control_role": "positive",
  "description": "signed offset p + off < p",
  "functions": [
    "fwd_ok"
  ],
  "guard_ids": [
    46
  ],
  "loops": false,
  "alive2_unroll": 0,
  "inputs": [
    {
      "args": [
        "0"
      ],
      "guard": "pass",
      "expect_reports": [],
      "expect_guard_output": false
    },
    {
      "args": [
        "15"
      ],
      "guard": "pass",
      "expect_reports": [],
      "expect_guard_output": false,
      "note": "last valid byte"
    },
    {
      "args": [
        "-1"
      ],
      "guard": "trip",
      "expect_reports": [],
      "expect_guard_output": true,
      "note": "p - 1 is before the object: UB, no sanitizer instruments it"
    },
    {
      "args": [
        "-9223372036854775808"
      ],
      "guard": "trip",
      "expect_reports": [
        "ubsan:pointer-overflow",
        "asan:SEGV"
      ],
      "expect_guard_output": false,
      "boundary": true,
      "note": "INT64_MIN: p + off really wraps, so the -O0 pointer comparison is false and the guard is bypassed (segfault); the UB-licensed rewrite to off < 0 rejects it"
    }
  ]
}
